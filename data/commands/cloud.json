{
  "category": "cloud",
  "commands": [
    {
      "name": "aws",
      "match": [
        "aws"
      ],
      "summary": "AWS command line",
      "risk": "high",
      "risk_reason": "Acts on real cloud resources; the wrong profile/region affects the wrong account.",
      "cautions": [
        "Always check account + region before changes (sts get-caller-identity).",
        "Credentials in environment variables or ~/.aws/credentials grant everything the user can do — use SSO / short-lived roles.",
        "Use --dry-run (EC2) and `aws s3 ... --dryrun` wherever available."
      ],
      "explanation": "Entry point for AWS services. Check the account with `aws sts get-caller-identity`.",
      "flags": [
        {
          "flag": "--profile",
          "long": "--profile",
          "desc": "Credentials profile"
        },
        {
          "flag": "--region",
          "long": "--region",
          "desc": "Region"
        },
        {
          "flag": "--dry-run",
          "long": "--dry-run",
          "desc": "Validate (EC2 only)"
        },
        {
          "flag": "--query",
          "long": "--query",
          "desc": "JMESPath filter"
        },
        {
          "flag": "--output",
          "long": "--output",
          "desc": "json|table|text"
        }
      ],
      "examples": [
        {
          "cmd": "aws sts get-caller-identity",
          "desc": "Who am I?"
        },
        {
          "cmd": "aws ec2 describe-instances --output table",
          "desc": "List instances"
        }
      ],
      "safer": [
        {
          "cmd": "aws sts get-caller-identity",
          "why": "Confirm the account first"
        },
        {
          "cmd": "aws configure list",
          "why": "Check profile/region"
        }
      ],
      "suggestions": [
        "aws s3",
        "aws ec2"
      ],
      "low_when": [
        "\\b(describe|list|get|ls|sts get-caller-identity|help|configure list)\\b"
      ],
      "low_unless": [
        "delete|terminate|remove|rm|put|create|run|update|modify|detach|deregister|--force"
      ]
    },
    {
      "name": "aws s3",
      "match": [
        "aws s3"
      ],
      "summary": "S3 object storage commands",
      "risk": "high",
      "risk_reason": "rm/sync --delete/rb remove objects irreversibly (unless versioning).",
      "cautions": [
        "Use --dryrun first for sync/rm/mv.",
        "sync --delete mirrors deletions — pointing the wrong way erases the destination.",
        "Public ACLs/policies expose data: keep Block Public Access on.",
        "Enable versioning + MFA delete for critical buckets."
      ],
      "explanation": "High-level S3 commands: ls, cp, mv, rm, sync, rb.",
      "flags": [
        {
          "flag": "ls",
          "desc": "List"
        },
        {
          "flag": "cp",
          "desc": "Copy"
        },
        {
          "flag": "sync",
          "desc": "Synchronise folders"
        },
        {
          "flag": "rm --recursive",
          "desc": "Delete many objects",
          "caution": "Irreversible without versioning."
        },
        {
          "flag": "--dryrun",
          "long": "--dryrun",
          "desc": "Show what would happen"
        },
        {
          "flag": "--delete",
          "long": "--delete",
          "desc": "Remove destination objects not in source",
          "caution": "Can wipe a bucket."
        },
        {
          "flag": "rb --force",
          "desc": "Remove a bucket and contents",
          "caution": "Permanent."
        }
      ],
      "examples": [
        {
          "cmd": "aws s3 ls s3://my-bucket --recursive --human-readable --summarize",
          "desc": "Size of a bucket"
        },
        {
          "cmd": "aws s3 sync ./site s3://my-bucket --dryrun",
          "desc": "Preview a sync"
        }
      ],
      "safer": [
        {
          "cmd": "aws s3 sync <src> <dst> --dryrun",
          "why": "Preview"
        },
        {
          "cmd": "aws s3api get-bucket-versioning --bucket <b>",
          "why": "Check versioning"
        }
      ],
      "suggestions": [
        "aws",
        "aws s3api"
      ],
      "low_when": [
        "\\bls\\b|--dryrun"
      ],
      "low_unless": [
        "\\b(rm|rb|mv|sync|cp)\\b(?!.*--dryrun)"
      ]
    },
    {
      "name": "aws s3api",
      "match": [
        "aws s3api"
      ],
      "summary": "Low-level S3 API",
      "risk": "high",
      "risk_reason": "Direct policy/ACL/object-version operations.",
      "cautions": [
        "put-bucket-policy / put-bucket-acl can make data public.",
        "delete-objects with versions removes history permanently."
      ],
      "explanation": "Exposes every S3 API call: bucket policies, versioning, lifecycle.",
      "flags": [],
      "examples": [
        {
          "cmd": "aws s3api get-bucket-policy --bucket b",
          "desc": "Show policy"
        },
        {
          "cmd": "aws s3api list-object-versions --bucket b",
          "desc": "Versions"
        }
      ],
      "safer": [
        {
          "cmd": "aws s3api get-bucket-policy --bucket <b> > policy.bak",
          "why": "Back up the policy first"
        }
      ],
      "suggestions": [
        "aws s3"
      ],
      "low_when": [
        "\\b(get|list|head)-"
      ],
      "low_unless": [
        "\\b(put|delete)-"
      ]
    },
    {
      "name": "aws ec2",
      "match": [
        "aws ec2"
      ],
      "summary": "EC2 instances and networking",
      "risk": "high",
      "risk_reason": "terminate-instances deletes servers and their root disks.",
      "cautions": [
        "terminate-instances cannot be undone — enable termination protection on critical hosts.",
        "Opening 0.0.0.0/0 on SSH/RDP/DB ports is a common breach path.",
        "Stopping instances loses ephemeral (instance-store) data and may change public IPs."
      ],
      "explanation": "Manage instances, volumes, security groups and AMIs.",
      "flags": [
        {
          "flag": "describe-instances",
          "desc": "List instances"
        },
        {
          "flag": "stop-instances",
          "desc": "Stop"
        },
        {
          "flag": "terminate-instances",
          "desc": "Delete",
          "caution": "Irreversible; root EBS volumes are deleted by default."
        },
        {
          "flag": "authorize-security-group-ingress",
          "desc": "Open a port",
          "caution": "0.0.0.0/0 exposes the service to the Internet."
        },
        {
          "flag": "--dry-run",
          "long": "--dry-run",
          "desc": "Check permissions without acting"
        }
      ],
      "examples": [
        {
          "cmd": "aws ec2 describe-instances --filters Name=tag:Env,Values=prod",
          "desc": "Prod instances"
        },
        {
          "cmd": "aws ec2 stop-instances --instance-ids i-123 --dry-run",
          "desc": "Dry run"
        }
      ],
      "safer": [
        {
          "cmd": "aws ec2 <action> --dry-run",
          "why": "Validate permissions without acting"
        },
        {
          "cmd": "aws ec2 create-snapshot --volume-id <vol>",
          "why": "Snapshot before destructive changes"
        }
      ],
      "suggestions": [
        "aws"
      ],
      "low_when": [
        "\\bdescribe-"
      ],
      "low_unless": [
        "terminate|stop|reboot|delete|authorize|revoke|run-instances|modify"
      ]
    },
    {
      "name": "aws iam",
      "match": [
        "aws iam"
      ],
      "summary": "IAM identities and policies",
      "risk": "high",
      "risk_reason": "Wrong policies grant admin access or lock everyone out.",
      "cautions": [
        "Policies with Action:\"*\" / Resource:\"*\" grant full access.",
        "Deleting or detaching a role can break running workloads.",
        "Access keys: rotate regularly; never commit them."
      ],
      "explanation": "Manage users, roles and policies. See the flags and examples below, and run `man aws` for the full reference.",
      "flags": [],
      "examples": [
        {
          "cmd": "aws iam list-users",
          "desc": "List users"
        },
        {
          "cmd": "aws iam get-account-authorization-details",
          "desc": "Full dump"
        }
      ],
      "safer": [
        {
          "cmd": "aws iam simulate-principal-policy --policy-source-arn <arn> --action-names <a>",
          "why": "Simulate before attaching"
        },
        {
          "cmd": "aws iam get-policy-version …",
          "why": "Review current policy"
        }
      ],
      "suggestions": [
        "aws sts"
      ],
      "low_when": [
        "\\b(list|get)-"
      ],
      "low_unless": [
        "create|delete|attach|detach|put|update|add|remove"
      ]
    },
