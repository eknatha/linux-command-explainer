        "Service principal secrets must not be committed."
      ],
      "explanation": "Manage Azure from the terminal. See the flags and examples below, and run `man az` for the full reference.",
      "flags": [
        {
          "flag": "account show",
          "desc": "Current subscription"
        },
        {
          "flag": "account set --subscription",
          "desc": "Switch subscription"
        },
        {
          "flag": "group delete",
          "desc": "Delete a resource group",
          "caution": "Deletes everything inside."
        },
        {
          "flag": "--output table",
          "desc": "Readable output"
        }
      ],
      "examples": [
        {
          "cmd": "az account show -o table",
          "desc": "Where am I?"
        },
        {
          "cmd": "az vm list -o table",
          "desc": "VMs"
        }
      ],
      "safer": [
        {
          "cmd": "az account show -o table",
          "why": "Confirm the subscription"
        },
        {
          "cmd": "az group show -n <rg>",
          "why": "Inspect before deleting"
        }
      ],
      "suggestions": [
        "az group",
        "az vm"
      ],
      "low_when": [
        "\\b(list|show|ls|account show|version|-h)\\b"
      ],
      "low_unless": [
        "delete|create|update|set|stop|deallocate|remove|start|restart|add"
      ]
