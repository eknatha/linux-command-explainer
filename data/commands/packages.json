{
  "category": "packages",
  "commands": [
    {
      "name": "apt",
      "match": [
        "apt"
      ],
      "summary": "Debian/Ubuntu package manager",
      "risk": "high",
      "risk_reason": "Installs/removes software as root; autoremove/purge delete data.",
      "cautions": [
        "Simulate with -s first and read the “will be REMOVED” list.",
        "`apt upgrade`/`full-upgrade` can restart services and replace kernels — schedule maintenance.",
        "Don’t mix third-party repositories carelessly; pin versions in production.",
        "Back up configs before purge."
      ],
      "explanation": "High-level package tool: update, install, remove, upgrade, autoremove.",
      "flags": [
        {
          "flag": "update",
          "desc": "Refresh the package index"
        },
        {
          "flag": "install",
          "desc": "Install"
        },
        {
          "flag": "remove",
          "desc": "Remove packages (keep config)"
        },
        {
          "flag": "purge",
          "desc": "Remove packages and config",
          "caution": "Deletes configuration."
        },
        {
          "flag": "autoremove",
          "desc": "Remove unused dependencies",
          "caution": "May remove things you still need."
        },
        {
          "flag": "-s",
          "desc": "-s",
          "caution": "Simulate"
        },
        {
          "flag": "--dry-run",
          "long": "--dry-run",
          "desc": "Simulate"
        }
      ],
      "examples": [
        {
          "cmd": "apt list --upgradable",
          "desc": "What can be upgraded?"
        },
        {
          "cmd": "apt install -s nginx",
          "desc": "Simulate"
        }
      ],
      "safer": [
        {
          "cmd": "apt install -s <pkg>",
          "why": "Simulate"
        },
        {
          "cmd": "apt-mark showhold",
          "why": "Check held packages"
        }
      ],
      "suggestions": [
        "apt-get",
        "dpkg"
      ],
      "low_when": [
        "\\b(list|search|show|policy|depends)\\b|\\s-s\\b|--dry-run"
      ],
      "low_unless": [
        "install|remove|purge|upgrade|autoremove|dist-upgrade"
      ]
    },
    {
      "name": "apt-get",
      "match": [
        "apt-get"
      ],
      "summary": "Debian package tool",
      "risk": "high",
      "risk_reason": "Installs/removes packages as root.",
      "cautions": [
        "-y hides removals — simulate first.",
        "Run apt-get update before install to avoid stale indexes."
      ],
      "explanation": "Scriptable apt interface. See the flags and examples below, and run `man apt-get` for the full reference.",
      "flags": [
        {
          "flag": "-s",
          "desc": "Simulate"
        },
        {
          "flag": "-y",
          "desc": "Assume yes",
          "caution": "Skips confirmation prompts."
        },
        {
          "flag": "install",
          "desc": "Install"
        },
        {
          "flag": "remove",
          "desc": "Remove"
        },
        {
          "flag": "dist-upgrade",
          "desc": "Upgrade with dependency changes"
        }
      ],
      "examples": [
        {
          "cmd": "apt-get -s upgrade",
          "desc": "Simulate an upgrade"
        }
      ],
      "safer": [
        {
          "cmd": "apt-get -s <action> <pkg>",
          "why": "Simulate"
        }
      ],
      "suggestions": [
        "apt",
        "dpkg"
      ],
      "low_when": [
        "-s\\b|--simulate|--dry-run|\\b(check|source|download)\\b"
      ],
      "low_unless": [
        "install|remove|purge|upgrade|autoremove"
      ]
    },
    {
      "name": "dpkg",
      "match": [
        "dpkg"
      ],
      "summary": "Debian package manager (low level)",
      "risk": "high",
      "risk_reason": "--force options bypass dependency checks.",
      "cautions": [
        "--force-* breaks dependencies.",
        "Only install .deb files from trusted sources."
      ],
      "explanation": "Installs .deb files and queries installed packages.",
      "flags": [
        {
          "flag": "-l",
          "desc": "List packages"
        },
        {
          "flag": "-L",
          "desc": "Files of a package"
        },
        {
          "flag": "-S",
          "desc": "Which package owns a file"
        },
        {
          "flag": "-i",
          "desc": "Install a .deb"
        },
        {
          "flag": "--purge",
          "long": "--purge",
          "desc": "Remove with config"
        }
      ],
      "examples": [
        {
          "cmd": "dpkg -l | grep nginx",
          "desc": "Is it installed?"
        },
        {
          "cmd": "dpkg -S /usr/bin/ls",
          "desc": "Owner"
        }
      ],
      "suggestions": [
        "apt"
      ],
      "low_when": [
        "\\s-(l|L|S|s|V)\\b|--list|--listfiles|--search|--status"
      ],
      "low_unless": [
        "-i|-r|-P|--purge|--remove|--force"
      ]
    },
    {
      "name": "yum",
      "match": [
        "yum"
      ],
      "summary": "RHEL/CentOS package manager (legacy)",
      "risk": "high",
      "risk_reason": "Installs/removes software as root.",
      "cautions": [
        "Use `--assumeno` to preview; `yum history undo` can roll back a transaction."
      ],
      "explanation": "Legacy tool; dnf is the successor. See the flags and examples below, and run `man yum` for the full reference.",
      "flags": [],
      "examples": [
        {
          "cmd": "yum check-update",
          "desc": "Updates available"
        },
        {
          "cmd": "yum history",
          "desc": "Transaction history"
        }
      ],
      "suggestions": [
        "dnf"
      ],
      "low_when": [
        "check-update|list|info|search|history(?! undo)"
      ],
      "low_unless": [
        "install|remove|erase|update|upgrade|history undo"
      ]
    },
    {
      "name": "dnf",
      "match": [
        "dnf"
      ],
      "summary": "RHEL/Fedora package manager",
      "risk": "high",
      "risk_reason": "Installs/removes packages as root; removes can cascade.",
      "cautions": [
        "Use --assumeno to preview.",
        "Remove can uninstall dependent packages (e.g. sudo) — read the list.",
        "Use `dnf history undo` to roll back mistakes."
      ],
      "explanation": "Package manager with transaction history for rollback.",
      "flags": [
        {
          "flag": "install",
          "desc": "Install"
        },
        {
          "flag": "remove",
          "desc": "Remove (check dependency removals)"
        },
        {
          "flag": "upgrade",
          "desc": "Upgrade all",
          "caution": "May restart services/change kernel."
        },
        {
          "flag": "history",
          "desc": "Past transactions"
        },
        {
          "flag": "history undo",
          "desc": "Undo a transaction"
        },
        {
          "flag": "--assumeno",
          "long": "--assumeno",
          "desc": "Preview only"
        }
      ],
      "examples": [
        {
          "cmd": "dnf check-update",
          "desc": "What is available?"
        },
        {
          "cmd": "dnf history",
          "desc": "Transactions"
        },
        {
          "cmd": "dnf upgrade --assumeno",
          "desc": "Preview"
        }
      ],
      "safer": [
        {
          "cmd": "dnf upgrade --assumeno",
          "why": "Preview"
        },
        {
          "cmd": "dnf history undo <id>",
          "why": "Roll back"
        }
      ],
      "suggestions": [
        "rpm",
        "yum"
      ],
      "low_when": [
        "check-update|list|info|search|repolist|provides|history$|history list|history info|--assumeno"
      ],
      "low_unless": [
        "install|remove|erase|upgrade|update|autoremove|history undo"
      ]
    },
    {
      "name": "rpm",
      "match": [
        "rpm"
      ],
      "summary": "RPM package tool",
      "risk": "high",
      "risk_reason": "--force/--nodeps bypass safety checks.",
      "cautions": [
        "Never use --nodeps/--force casually.",
        "Verify signatures (rpm -K) of downloaded RPMs."
      ],
      "explanation": "Query and install RPM packages. See the flags and examples below, and run `man rpm` for the full reference.",
      "flags": [
        {
          "flag": "-qa",
          "desc": "All packages"
        },
        {
          "flag": "-qi",
          "desc": "Package info"
        },
        {
          "flag": "-ql",
          "desc": "Files of a package"
        },
        {
          "flag": "-qf",
          "desc": "Owner of a file"
        },
        {
          "flag": "--nodeps",
          "long": "--nodeps",
          "desc": "Skip dependency checks",
          "caution": "Can break the system."
        },
        {
          "flag": "-V",
          "desc": "Verify a package"
        }
      ],
      "examples": [
        {
          "cmd": "rpm -qf /usr/bin/ls",
          "desc": "Who owns this file?"
        },
        {
          "cmd": "rpm -V openssh-server",
          "desc": "Verify"
        }
      ],
      "suggestions": [
        "dnf"
      ],
      "low_when": [
        "-q|-V|--query|--verify|-K"
      ],
      "low_unless": [
        "-i|-U|-e|--erase|--nodeps|--force"
      ]
    },
